{
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)",
      "Bash(git worktree:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(screencapture:*)",
      "Bash(scripts/argo-screenshot.sh:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(git merge:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-dev-tools.sh",
            "timeout": 15,
            "statusMessage": "校验 Argo 开发环境（superpowers + codegraph）"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-dev-tools.sh",
            "timeout": 15,
            "statusMessage": "校验 Argo 开发环境（superpowers + codegraph）"
          }
        ]
      }
    ]
  }
}
